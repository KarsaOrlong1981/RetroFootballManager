<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RetroFootballManager.Views.Controls.TeamDetailDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    x:Name="Root">

    <Grid IsVisible="{Binding IsOpen, Source={x:Reference Root}}" BackgroundColor="#B0000000">
        <Border StrokeThickness="1" Stroke="{StaticResource RfmAccentTeal}"
                BackgroundColor="{StaticResource RfmBackground}"
                Margin="20" Padding="18"
                MaximumWidthRequest="560" MaximumHeightRequest="620"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding Detail.Name, Source={x:Reference Root}}" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" ImageSource="close.png" Command="{Binding CloseCommand, Source={x:Reference Root}}"
                            BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}"
                            WidthRequest="36" HeightRequest="36" Padding="8" />
                </Grid>

                <ScrollView Grid.Row="1" BindingContext="{Binding Detail, Source={x:Reference Root}}" x:DataType="vm:TeamDetail">
                    <VerticalStackLayout Spacing="10">

                        <Border StrokeThickness="0" Padding="10" BackgroundColor="{StaticResource RfmSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding SquadStrength, StringFormat='Kaderstärke: {0:0.0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Morale, StringFormat='Moral: {0}%'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Form, StringFormat='Form: {0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmAccentTeal}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding MatchesPlayed, StringFormat='Spiele: {0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                            </Grid>
                        </Border>

                        <Label Text="Saison-Statistik (Schnitt/Spiel)" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                        <Border StrokeThickness="0" Padding="10" BackgroundColor="{StaticResource RfmSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding AveragePossession, StringFormat='Ballbesitz: {0}%'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding AveragePassAccuracy, StringFormat='Passquote: {0}%'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding AverageCorners, StringFormat='Ecken: {0:0.0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding AverageFreeKicks, StringFormat='Freistöße: {0:0.0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding AveragePenaltys, StringFormat='Elfmeter: {0:0.0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding AverageOffsides, StringFormat='Abseits: {0:0.0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                            </Grid>
                        </Border>

                        <Button Text="Trainer ansehen" Command="{Binding ShowManagerCommand, Source={x:Reference Root}}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}" />

                        <Label Text="Finanzen" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                        <Border StrokeThickness="0" Padding="10" BackgroundColor="{StaticResource RfmSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding BalanceText, StringFormat='Kontostand: {0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Text="{Binding TransferBudgetText, StringFormat='Transferbudget: {0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmText}" />
                                <Label Text="{Binding Finance.FinancialHealth, StringFormat='Finanzielle Gesundheit: {0}/100'}"
                                       FontSize="16" TextColor="{StaticResource RfmAccentTeal}" />
                                <Label Text="{Binding Finance.AccuracyLabel, StringFormat='Genauigkeit: {0}'}"
                                       FontSize="14" TextColor="{StaticResource RfmTextMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="2" Text="Schließen" Command="{Binding CloseCommand, Source={x:Reference Root}}"
                        BackgroundColor="{StaticResource RfmAccent}" FontSize="18" TextColor="White" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
