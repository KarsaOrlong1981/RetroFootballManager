<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RetroFootballManager.Views.Controls.SteppedAmountInput"
             x:Name="Root">
    <HorizontalStackLayout Spacing="8">
        <Button Text="-" WidthRequest="34" HeightRequest="32" Padding="0" FontAttributes="Bold"
                Clicked="OnDownClicked" BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="2">
            <Label Grid.Column="0" Text="{Binding Millions, Source={x:Reference Root}, StringFormat='{0:000}'}"
                   FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Label Grid.Column="1" Text="." FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Label Grid.Column="2" Text="{Binding Thousands, Source={x:Reference Root}, StringFormat='{0:000}'}"
                   FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Label Grid.Column="3" Text="." FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Label Grid.Column="4" Text="{Binding Units, Source={x:Reference Root}, StringFormat='{0:000}'}"
                   FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
        </Grid>
        <Button Text="+" WidthRequest="34" HeightRequest="32" Padding="0" FontAttributes="Bold"
                Clicked="OnUpClicked" BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
    </HorizontalStackLayout>
</ContentView>
