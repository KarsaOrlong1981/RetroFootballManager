<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RetroFootballManager.Views.Controls.PresetStepInput"
             x:Name="Root">
    <HorizontalStackLayout Spacing="8">
        <Button Text="-" WidthRequest="34" HeightRequest="32" Padding="0" FontAttributes="Bold"
                Clicked="OnDownClicked" BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
        <Label Text="{Binding DisplayText, Source={x:Reference Root}}" FontSize="16" FontAttributes="Bold"
               WidthRequest="90" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource RfmAccentTeal}" />
        <Button Text="+" WidthRequest="34" HeightRequest="32" Padding="0" FontAttributes="Bold"
                Clicked="OnUpClicked" BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
    </HorizontalStackLayout>
</ContentView>
