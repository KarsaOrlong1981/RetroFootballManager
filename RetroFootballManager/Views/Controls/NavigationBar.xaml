<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RetroFootballManager.Views.Controls.NavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    x:DataType="vm:NavigationBarViewModel">

    <ContentView.Resources>
        <Style x:Key="WindowChromeButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource RfmTextMuted}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </ContentView.Resources>

    <Grid
        ColumnDefinitions="Auto,*,Auto"
        HeightRequest="52"
        BackgroundColor="{StaticResource RfmSurface}">

        <ImageButton
            Grid.Column="0"
            Source="backbutton.png"
            BackgroundColor="Transparent"
            WidthRequest="34"
            HeightRequest="34"
            Padding="6"
            IsVisible="{Binding CanGoBack}"
            Command="{Binding GoBackCommand}"
            Margin="8,0,0,0" />

        <Label
            Grid.Column="1"
            Text="{Binding Title}"
            TextColor="{StaticResource RfmText}"
            FontAttributes="Bold"
            FontSize="16"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

        <HorizontalStackLayout Grid.Column="2" Spacing="2" Margin="0,0,8,0">
            <Button
                Text="&#8212;"
                Style="{StaticResource WindowChromeButtonStyle}"
                ToolTipProperties.Text="Minimieren"
                Command="{Binding MinimizeCommand}" />
            <Button
                Text="&#10005;"
                Style="{StaticResource WindowChromeButtonStyle}"
                ToolTipProperties.Text="Beenden"
                Command="{Binding CloseAppCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
