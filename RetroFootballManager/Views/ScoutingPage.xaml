<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.ScoutingPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    xmlns:behaviors="clr-namespace:RetroFootballManager.Behaviors"
    x:DataType="vm:ScoutingViewModel"
    Title="Scouting"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Image Source="scouting.png" Aspect="AspectFill"/>
        <ScrollView>
            <VerticalStackLayout Opacity="0.85" Padding="16" Spacing="14">

                <Label Text="Sie haben aktuell keinen Scout angestellt."
                       FontSize="22" TextColor="{StaticResource RfmTextMuted}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasScout}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding HasScout}" Value="False">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding HasScout}">

                    <Label Text="Scouts" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Scouts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScoutRow">
                                <Border StrokeThickness="0" Padding="12,8" HorizontalOptions="Start" WidthRequest="850" BackgroundColor="{StaticResource RfmSurface}" StrokeShape="RoundRectangle 10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Image Source="{Binding ImagePath}" WidthRequest="150" HeightRequest="150"/>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label FontSize="18" TextColor="{StaticResource RfmText}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Name}" />
                                                        <Span Text="  ·  Fähigkeit " TextColor="{StaticResource RfmTextMuted}" />
                                                        <Span Text="{Binding ScoutingAbility}" TextColor="{StaticResource RfmAccentTeal}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding FocusSummary}" FontSize="18" LineBreakMode="WordWrap" TextColor="{StaticResource RfmTextMuted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding ActiveAssignments, StringFormat='{0}/6'}"
                                               FontSize="28" TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                        <Button Grid.Column="3" Text="Fokus"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenScoutingFocusCommand}"
                                                CommandParameter="{Binding EmployeeId}"
                                                BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmText}" FontSize="18" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Active scouting / recommendations / scouted-players lists moved into
                         their own dialogs (same pattern as TransferMarketPage) - all three can
                         grow large over a long career, and realizing that many complex rows
                         inline was a confirmed WinUI crash risk (see feedback-maui-windows-
                         crash-gotchas memory). "Scouts" stays inline - bounded by staff slots. -->
                    <HorizontalStackLayout Spacing="16" Margin="0,8,0,0">
                        <Button Text="Aktive Aufträge" FontSize="20" Padding="20,14"
                                Command="{Binding OpenActiveScoutingDialogCommand}"
                                BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmBackground}" />
                        <Button Text="Empfehlungen" FontSize="20" Padding="20,14"
                                Command="{Binding OpenRecommendationsDialogCommand}"
                                BackgroundColor="{StaticResource RfmAccent}" TextColor="White" />
                        <Button Text="Gescoutete Spieler" FontSize="20" Padding="20,14"
                                Command="{Binding OpenScoutedPlayersDialogCommand}"
                                BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmBackground}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding StatusText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Scouting-Fokus dialog: assign search criteria to one scout - falls back to the
             team-weakness analysis when no filter is set. -->
        <Grid IsVisible="{Binding IsScoutingFocusDialogOpen}" BackgroundColor="#B0000000">
            <Border StrokeThickness="1" Stroke="{StaticResource RfmAccentTeal}"
                    BackgroundColor="{StaticResource RfmBackground}"
                    Margin="16" Padding="16"
                    MaximumWidthRequest="560" MaximumHeightRequest="720"
                    HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 16">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Label Grid.Row="0" Text="{Binding FocusScoutName, StringFormat='Scouting-Fokus: {0}'}"
                           FontSize="20" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Alle Filter sind optional - ist keiner gesetzt, sucht der Scout gezielt nach Kaderschwächen."
                                   FontSize="13" TextColor="{StaticResource RfmTextMuted}" />

                            <Picker Title="Position" ItemsSource="{Binding PositionFilterOptions}" ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding FocusPosition, Mode=TwoWay}"
                                    TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />

                            <Label Text="Alter" FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="min." VerticalOptions="Center" TextColor="{StaticResource RfmTextMuted}" />
                                    <controls:SteppedIntegerInput Minimum="10" Maximum="50" Increment="1"
                                           Value="{Binding FocusMinAge, Mode=TwoWay}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="max." VerticalOptions="Center" TextColor="{StaticResource RfmTextMuted}" />
                                    <controls:SteppedIntegerInput Minimum="10" Maximum="50" Increment="1"
                                           Value="{Binding FocusMaxAge, Mode=TwoWay}" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Label Text="Talent (1 = schwach, 99 = Weltklasse)" FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="min." VerticalOptions="Center" TextColor="{StaticResource RfmTextMuted}" />
                                    <controls:SteppedIntegerInput Minimum="1" Maximum="99" Increment="1"
                                           Value="{Binding FocusMinTalent, Mode=TwoWay}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="max." VerticalOptions="Center" TextColor="{StaticResource RfmTextMuted}" />
                                    <controls:SteppedIntegerInput Minimum="1" Maximum="99" Increment="1"
                                           Value="{Binding FocusMaxTalent, Mode=TwoWay}" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Label Text="Spielstärke (Rating, 1-99)" FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="min." VerticalOptions="Center" TextColor="{StaticResource RfmTextMuted}" />
                                <controls:SteppedIntegerInput Minimum="1" Maximum="99" Increment="1"
                                       Value="{Binding FocusMinRating, Mode=TwoWay}" />
                            </HorizontalStackLayout>

                            <Picker Title="Charakter" ItemsSource="{Binding CharacterFilterOptions}" ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding FocusCharacter, Mode=TwoWay}"
                                    TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />

                            <Picker Title="Persönlichkeit" ItemsSource="{Binding PersonalityFilterOptions}" ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding FocusPersonality, Mode=TwoWay}"
                                    TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />

                            <Picker Title="Land" ItemsSource="{Binding NationalityFilterOptions}" ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding FocusNationality, Mode=TwoWay}"
                                    TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />

                            <Label Text="Zusätzlicher Attributfilter (optional): der Scout sucht nur nach Spielern, deren gewähltes Attribut mindestens den Wert daneben erreicht (Skala 1-99)."
                                   FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Picker Grid.Column="0" Title="Attribut" ItemsSource="{Binding AttributeFilterOptions}" ItemDisplayBinding="{Binding Label}"
                                        SelectedItem="{Binding FocusAttribute, Mode=TwoWay}"
                                        TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />
                                <Entry Grid.Column="1" Placeholder="Mindestwert (1-99)" Keyboard="Numeric"
                                       Text="{Binding FocusAttributeMinValueText, Mode=TwoWay}" TextColor="{StaticResource RfmText}">
                                    <Entry.Behaviors>
                                        <behaviors:NumericOnlyBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                            </Grid>

                            <Label Text="{Binding FocusStatusText}" FontSize="14" TextColor="{StaticResource RfmAccentTeal}" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Abbrechen" Command="{Binding CloseScoutingFocusCommand}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}" FontSize="18" />
                        <Button Grid.Column="1" Text="Speichern" Command="{Binding SaveScoutingFocusCommand}"
                                BackgroundColor="{StaticResource RfmAccent}" TextColor="White" FontSize="18" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Active scouting dialog -->
        <Grid IsVisible="{Binding IsActiveScoutingDialogOpen}" BackgroundColor="#B0000000">
            <Border StrokeThickness="1" Stroke="{StaticResource RfmAccentTeal}"
                    BackgroundColor="{StaticResource RfmBackground}"
                    Margin="20" Padding="18"
                    WidthRequest="880" HeightRequest="850"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Scout scoutet aktuell diese Spieler" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" ImageSource="close.png" Command="{Binding CloseActiveScoutingDialogCommand}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}"
                                WidthRequest="36" HeightRequest="36" Padding="8" />
                    </Grid>
                    <ScrollView Grid.Row="1" Margin="0,12,0,0">
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ActiveScoutingPage}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActiveScoutingRow">
                                    <Border StrokeThickness="0" Padding="12,8" BackgroundColor="{StaticResource RfmSurface}" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label FontSize="18" TextColor="{StaticResource RfmText}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding PlayerName}" />
                                                            <Span Text=" (" />
                                                            <Span Text="{Binding PositionShort}" />
                                                            <Span Text=") - " />
                                                            <Span Text="{Binding TeamName}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding DaysRemaining, StringFormat='noch {0} Tage'}"
                                                   FontSize="18" TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                            <Border Grid.Column="0" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="32" HeightRequest="32" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}"
                                                        CommandParameter="{Binding PlayerId}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="info.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                        <Button Grid.Column="0" Text="Zurück" FontSize="16" Padding="14,8"
                                Command="{Binding PreviousActiveScoutingPageCommand}"
                                IsEnabled="{Binding CanGoToPreviousActiveScoutingPage}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource RfmTextMuted}" BorderWidth="1"
                                TextColor="{StaticResource RfmText}" />
                        <Label Grid.Column="1" Text="{Binding ActiveScoutingPageInfo}" FontSize="16"
                               TextColor="{StaticResource RfmTextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="Weiter" FontSize="16" Padding="14,8"
                                Command="{Binding NextActiveScoutingPageCommand}"
                                IsEnabled="{Binding CanGoToNextActiveScoutingPage}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource RfmTextMuted}" BorderWidth="1"
                                TextColor="{StaticResource RfmText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Recommendations dialog -->
        <Grid IsVisible="{Binding IsRecommendationsDialogOpen}" BackgroundColor="#B0000000">
            <Border StrokeThickness="1" Stroke="{StaticResource RfmAccentTeal}"
                    BackgroundColor="{StaticResource RfmBackground}"
                    Margin="20" Padding="18"
                    WidthRequest="880" HeightRequest="850"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Scout-Empfehlungen" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" ImageSource="close.png" Command="{Binding CloseRecommendationsDialogCommand}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}"
                                WidthRequest="36" HeightRequest="36" Padding="8" />
                    </Grid>
                    <ScrollView Grid.Row="1" Margin="0,12,0,0">
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding RecommendationsPage}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScoutRecommendationRow">
                                    <Border StrokeThickness="0" Padding="12,8" BackgroundColor="{StaticResource RfmSurface}" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="50,*" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label FontSize="18" TextColor="{StaticResource RfmText}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding PlayerName}" />
                                                            <Span Text=" (" /><Span Text="{Binding PositionShort}" /><Span Text=") - " />
                                                            <Span Text="{Binding TeamName}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding Reason}" FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="0" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="32" HeightRequest="32" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}"
                                                        CommandParameter="{Binding PlayerId}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="info.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                        <Button Grid.Column="0" Text="Zurück" FontSize="16" Padding="14,8"
                                Command="{Binding PreviousRecommendationsPageCommand}"
                                IsEnabled="{Binding CanGoToPreviousRecommendationsPage}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource RfmTextMuted}" BorderWidth="1"
                                TextColor="{StaticResource RfmText}" />
                        <Label Grid.Column="1" Text="{Binding RecommendationsPageInfo}" FontSize="16"
                               TextColor="{StaticResource RfmTextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="Weiter" FontSize="16" Padding="14,8"
                                Command="{Binding NextRecommendationsPageCommand}"
                                IsEnabled="{Binding CanGoToNextRecommendationsPage}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource RfmTextMuted}" BorderWidth="1"
                                TextColor="{StaticResource RfmText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Scouted players dialog -->
        <Grid IsVisible="{Binding IsScoutedPlayersDialogOpen}" BackgroundColor="#B0000000">
            <Border StrokeThickness="1" Stroke="{StaticResource RfmAccentTeal}"
                    BackgroundColor="{StaticResource RfmBackground}"
                    Margin="20" Padding="18"
                    WidthRequest="880" HeightRequest="850"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Bereits gescoutete Spieler" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" ImageSource="close.png" Command="{Binding CloseScoutedPlayersDialogCommand}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}"
                                WidthRequest="36" HeightRequest="36" Padding="8" />
                    </Grid>
                    <ScrollView Grid.Row="1" Margin="0,12,0,0">
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ScoutedPlayersPage}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScoutedPlayerRow">
                                    <Border StrokeThickness="0" Padding="12,8" BackgroundColor="{StaticResource RfmSurface}" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="50,*,Auto,36" ColumnSpacing="8">
                                            <Label Grid.Column="1" FontSize="18" TextColor="{StaticResource RfmText}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding PlayerName}" />
                                                        <Span Text=" (" />
                                                        <Span Text="{Binding PositionShort}" />
                                                        <Span Text=") - " />
                                                        <Span Text="{Binding TeamName}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="2" Text="{Binding ScoutedDateText}"
                                                   FontSize="16" TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                            <Border Grid.Column="0" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="32" HeightRequest="32" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}"
                                                        CommandParameter="{Binding PlayerId}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="info.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="3" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="32" HeightRequest="32" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveScoutedPlayerCommand}"
                                                        CommandParameter="{Binding PlayerId}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="close.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                        <Button Grid.Column="0" Text="Zurück" FontSize="16" Padding="14,8"
                                Command="{Binding PreviousScoutedPlayersPageCommand}"
                                IsEnabled="{Binding CanGoToPreviousScoutedPlayersPage}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource RfmTextMuted}" BorderWidth="1"
                                TextColor="{StaticResource RfmText}" />
                        <Label Grid.Column="1" Text="{Binding ScoutedPlayersPageInfo}" FontSize="16"
                               TextColor="{StaticResource RfmTextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="Weiter" FontSize="16" Padding="14,8"
                                Command="{Binding NextScoutedPlayersPageCommand}"
                                IsEnabled="{Binding CanGoToNextScoutedPlayersPage}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource RfmTextMuted}" BorderWidth="1"
                                TextColor="{StaticResource RfmText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Player profile dialog: full profile if scouted, otherwise "?" + Scouten button. -->
        <controls:PlayerProfileDialog
            IsOpen="{Binding IsPlayerProfileOpen}"
            Title="{Binding SelectedPlayerName}"
            Profile="{Binding SelectedProfile}"
            CloseCommand="{Binding CloseProfileCommand}"
            IsLocked="{Binding IsSelectedPlayerNotScouted}"
            LockedStatusText="{Binding ScoutingStatusText}"
            IsLockedBusy="{Binding IsBeingScouted}"
            UnlockCommand="{Binding ScoutPlayerCommand}">
            <controls:PlayerProfileDialog.ExtraContent>
                <!-- Only for scouted players at other clubs, not on the transfer market yet - the
                     seller's COM manager decides whether to accept, for a price above market value. -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding CanOfferForSelectedPlayer}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Text="Transferangebot"
                                Command="{Binding MakeUnsolicitedTransferOfferCommand}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}" FontSize="12" />
                        <Button Grid.Column="1" Text="Leihangebot"
                                Command="{Binding MakeUnsolicitedLoanOfferCommand}"
                                BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}" FontSize="12" />
                    </Grid>
                    <Label Text="{Binding OfferStatusText}" FontSize="11" TextColor="{StaticResource RfmAccentTeal}" />
                </VerticalStackLayout>
            </controls:PlayerProfileDialog.ExtraContent>
        </controls:PlayerProfileDialog>

        <controls:PlayerNegotiationsDialog BindingContext="{Binding Negotiation}" />
    </Grid>
</local:BaseContentPage>
