<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.ClubPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:ClubViewModel"
    Title="Verein"
    BackgroundColor="{StaticResource RfmBackground}">
    <Grid>
        <Image Aspect="Fill" Source="clubpage.png"/>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Opacity="0.85" Padding="20" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <Border Grid.Column="0" StrokeThickness="0" Padding="16" BackgroundColor="{StaticResource RfmSurface}" StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding ClubName}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                <Label Text="{Binding LeagueTierText}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                <Label Text="{Binding LeaguePositionText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
                <Label Text="{Binding StadiumSummary}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                <Label Text="{Binding RatingComparisonText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" Margin="0,4,0,0" />
                <Label Text="{Binding MoraleComparisonText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
            </VerticalStackLayout>
        </Border>

            <!-- Analyst: mit Profil schätzt er Rating/Moral/Finanzen aller anderen Vereine
                 (siehe TeamAssessmentEstimator); ohne Analyst zeigt die ganze Seite nur "?". -->
            <Border Grid.Column="1" StrokeThickness="0" Padding="14" WidthRequest="300" BackgroundColor="{StaticResource RfmSurface}"
                    IsVisible="{Binding HasAnalyst}" StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="{Binding AnalystImagePath}" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{Binding AnalystName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                        <Label Text="Analyst" FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
                        <Label Text="{Binding AnalystTeamAssessment, StringFormat='Team-Einschätzung: {0}'}"
                               FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Border Grid.Column="1" StrokeThickness="0" Padding="14" WidthRequest="300" BackgroundColor="{StaticResource RfmSurface}"
                    IsVisible="{Binding HasAnalyst, Converter={StaticResource InvertedBool}}" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Kein Analyst eingestellt." FontSize="18" TextColor="{StaticResource RfmText}" />
                    <Label Text="Ohne Analyst gibt es keine Einschätzung zu Rating, Moral und Finanzen anderer Vereine."
                           FontSize="16" TextColor="{StaticResource RfmAccentTeal}" />
                    <Button Text="Mitarbeiter" Command="{Binding OpenStaffCommand}" FontSize="13"
                            BackgroundColor="{StaticResource RfmAccent}" TextColor="White" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>
            </Grid>
        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Picker Title="Fitern nach Wettbewerb:"
                    FontSize="22"
                BackgroundColor="Blue"
                WidthRequest="380"
                ItemsSource="{Binding CompetitionKinds}"
                SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmText}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource CompetitionKindDisplay}" />
                </Picker.ItemDisplayBinding>
            </Picker>
            <Picker Title="Sortieren nach:"
                    FontSize="22"
                BackgroundColor="Blue"
                WidthRequest="280"
                ItemsSource="{Binding GroupConditionTypes}"
                SelectedItem="{Binding SelectedGroupConditionType, Mode=TwoWay}"
                TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmText}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource GroupConditionTypeDisplay}" />
                </Picker.ItemDisplayBinding>
            </Picker>
        </HorizontalStackLayout>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
            <CollectionView Grid.Row="1" ItemsSource="{Binding OtherTeams}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeamOverviewRow">
                        <Grid Padding="3">
                            <Border Padding="10,6" WidthRequest="800" HorizontalOptions="Start" BackgroundColor="{StaticResource RfmSurface}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowTeamDetailCommand}"
                                        CommandParameter="{Binding TeamId}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,80,120,*">
                                    <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource RfmLabel}" HorizontalOptions="Start" />
                                    <Label Grid.Column="1" FontSize="22" Text="{Binding RatingText}"
                                           TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" FontSize="22" Text="{Binding MoraleText}"
                                           TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Status}" HorizontalOptions="Center"
                                           TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <controls:TeamDetailDialog
            IsOpen="{Binding IsTeamDetailDialogOpen}"
            Detail="{Binding SelectedTeamDetail}"
            CloseCommand="{Binding CloseTeamDetailCommand}"
            ShowManagerCommand="{Binding ShowManagerProfileCommand}" />

        <controls:ManagerProfileDialog
            IsOpen="{Binding IsManagerProfileDialogOpen}"
            Profile="{Binding ViewedManagerProfile}"
            IsEditable="False"
            CloseCommand="{Binding CloseManagerProfileCommand}" />
    </Grid>
    </Grid>
</local:BaseContentPage>
