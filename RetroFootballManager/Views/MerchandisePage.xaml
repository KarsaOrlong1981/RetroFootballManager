<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.MerchandisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:MerchandiseViewModel"
    x:Name="Page"
    Title="Merchandise"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Übersicht (links) + Sportdirektor-Profil (oben rechts) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" WidthRequest="1280" HorizontalOptions="Start">
                    <Border Grid.Column="0" StrokeThickness="0" Padding="16" BackgroundColor="{StaticResource RfmSurface}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding MemberCountText}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding LeaguePositionText}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                            <Label Grid.Row="0" Grid.Column="2" Text="{Binding PerformanceFactorText}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}" />

                            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto">
                                <Label Text="Einnahmen (Saison)" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Grid.Column="1" Text="{Binding SeasonIncomeText}" TextColor="{StaticResource RfmAccentTeal}" FontAttributes="Bold" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <Label Text="Wareneinkauf (Saison)" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Grid.Column="1" Text="{Binding SeasonExpenseText}" TextColor="#EF4444" FontAttributes="Bold" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto">
                                <Label Text="Netto (Saison)" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Grid.Column="1" Text="{Binding SeasonNetText}" TextColor="{StaticResource RfmAccentTeal}" FontAttributes="Bold" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Sportdirektor: mit Profil kann man um eine Mengen-Einschätzung bitten;
                         ohne Direktor Link zu Mitarbeiter (wie auf der Finanzen-Seite). -->
                    <Border Grid.Column="1" StrokeThickness="0" Padding="14" WidthRequest="320" BackgroundColor="{StaticResource RfmSurface}"
                            IsVisible="{Binding HasDirectorOfFootball}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="{Binding DirectorOfFootballImagePath}" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding DirectorOfFootballName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                                <Label Text="Sportdirektor" FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Text="{Binding DirectorOfFootballFinancialManagement, StringFormat='Finanzmanagement: {0}'}"
                                       FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
                                <Button Text="Um Einschätzung bitten" Command="{Binding AskForRecommendationCommand}"
                                        FontSize="16" Padding="8,4"
                                        BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmText}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" StrokeThickness="0" Padding="14" WidthRequest="320" BackgroundColor="{StaticResource RfmSurface}"
                            IsVisible="{Binding HasDirectorOfFootball, Converter={StaticResource InvertedBool}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Kein Sportdirektor eingestellt." FontSize="18" TextColor="{StaticResource RfmText}" />
                            <Label Text="Mengenempfehlungen sind derzeit nicht möglich, die richtige Einschätzung liegt bei Ihnen, oder Sie stellen einen Direktor ein."
                                   FontSize="16" TextColor="{StaticResource RfmAccentTeal}" />
                            <Button Text="Mitarbeiter" Command="{Binding OpenStaffCommand}" FontSize="13"
                                    BackgroundColor="{StaticResource RfmAccent}" TextColor="White" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Mitglieder-Werbekampagne -->
                <Border StrokeThickness="0" Padding="14" HorizontalOptions="Start" WidthRequest="1280" BackgroundColor="{StaticResource RfmSurface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Mitglieder-Werbekampagne" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                                <Label Text="{Binding CampaignCostText, StringFormat='Kosten: {0}'}" FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Text="Ohne Sportdirektor keine Kampagne möglich - es lohnt sich, einen einzustellen."
                                       FontSize="16" TextColor="{StaticResource RfmAccentTeal}"
                                       IsVisible="{Binding HasDirectorOfFootball, Converter={StaticResource InvertedBool}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Kampagne starten" Command="{Binding LaunchCampaignCommand}"
                                    IsEnabled="{Binding CanLaunchCampaign}" VerticalOptions="Center"
                                    BackgroundColor="{StaticResource RfmAccent}" TextColor="White" />
                        </Grid>
                        <Label Text="{Binding CampaignProgressText}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}"
                               IsVisible="{Binding CampaignProgressText, Converter={StaticResource StringPresence}}" />
                        <Label Text="{Binding CampaignFeedbackText}" FontSize="13" TextColor="{StaticResource RfmAccentTeal}"
                               IsVisible="{Binding CampaignFeedbackText, Converter={StaticResource StringPresence}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Schrittweite für alle Mengen/Preis-Stepper (wie im Verhandlungsdialog) -->
                <Border StrokeThickness="0" Padding="14" HorizontalOptions="Start" WidthRequest="1280" BackgroundColor="{StaticResource RfmSurface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowDefinitions="Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Schrittweite Einkauf" TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                        <controls:PresetStepInput Grid.Column="1" Value="{Binding BuyStepSize}" />
                        <Label Grid.Column="2" Text="Schrittweite Preis" TextColor="{StaticResource RfmText}" VerticalOptions="Center" Margin="20,0,0,0" />
                        <controls:PresetStepInput Grid.Column="3" Value="{Binding PriceStepSize}" />
                        <Label Grid.Column="4" Text="Schrittweite Rückkauf" TextColor="{StaticResource RfmText}" VerticalOptions="Center" Margin="20,0,0,0" />
                        <controls:PresetStepInput Grid.Column="5" Value="{Binding SellBackStepSize}" />
                    </Grid>
                </Border>

                <!-- Artikel-Liste - BindableLayout statt CollectionView (bekannte Windows/WinUI-
                     Virtualisierungsprobleme mit interaktiven Per-Item-Controls, siehe Bench/
                     Reserve-Listen auf LineupPage). -->
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Articles}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MerchandiseArticleRow">
                            <Border StrokeThickness="0" Padding="14" HorizontalOptions="Start" WidthRequest="1280" BackgroundColor="{StaticResource RfmSurfaceAlt}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="220,*,*,*,220" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding SeasonText}" FontSize="14" TextColor="{StaticResource RfmTextMuted}" />
                                        <Label Text="{Binding WholesaleCostText}" FontSize="14" TextColor="{StaticResource RfmTextMuted}" />
                                        <Label Text="{Binding StockText}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding RecommendationText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}"
                                               IsVisible="{Binding RecommendationText, Converter={StaticResource StringPresence}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Spacing="4">
                                        <Label Text="Verkaufspreis" FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                                        <controls:SteppedAmountInput Value="{Binding SellPrice}"
                                                StepSize="{Binding Source={x:Reference Page}, Path=BindingContext.PriceStepSize}" />
                                        <Label Text="{Binding MarginText}" FontSize="13" TextColor="{StaticResource RfmAccentTeal}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Spacing="4">
                                        <Label Text="Einkaufsmenge" FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                                        <controls:SteppedAmountInput Value="{Binding BuyQuantity}"
                                                StepSize="{Binding Source={x:Reference Page}, Path=BindingContext.BuyStepSize}" />
                                        <Grid ColumnDefinitions="*,*">
                                            <Label Text="{Binding BuyCostText}" FontSize="13" TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Kaufen"
                                                    HorizontalOptions="End"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.BuyCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmBackground}"
                                                    FontSize="13" Padding="10,4" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Spacing="4">
                                        <Label Text="Rückkauf (50% Erstattung)" FontSize="13" TextColor="{StaticResource RfmTextMuted}" />
                                        <controls:SteppedAmountInput Value="{Binding SellBackQuantity}"
                                                StepSize="{Binding Source={x:Reference Page}, Path=BindingContext.SellBackStepSize}" />
                                        <Grid ColumnDefinitions="*,*">
                                            <Label Text="{Binding SellBackRefundText}" FontSize="13" TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Verkaufen"
                                                    HorizontalOptions="End"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SellBackCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}"
                                                    FontSize="13" Padding="10,4" />
                                        </Grid>
                                        <Label Text="{Binding FeedbackText}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource RfmAccentTeal}"
                                               IsVisible="{Binding FeedbackText, Converter={StaticResource StringPresence}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Spacing="4">
                                        <Label Text="{Binding LastWeekText}" FontSize="14" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding TotalText}" FontSize="14" TextColor="{StaticResource RfmTextMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}" WidthRequest="48" HeightRequest="48" />
                <Label Text="Wird gespeichert …" FontSize="20" TextColor="{StaticResource RfmText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</local:BaseContentPage>
