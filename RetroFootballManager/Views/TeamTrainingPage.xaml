<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.TeamTrainingPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    x:DataType="vm:TeamTrainingViewModel"
    Title="Team-Training"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Image Source="teamtraining.png" Aspect="AspectFill"/>
        <Grid Opacity="0.85" RowDefinitions="Auto,Auto,*" Padding="14" RowSpacing="10">

            <Label Grid.Row="0" FontSize="24" BackgroundColor="Black" HorizontalOptions="Start" TextColor="{StaticResource RfmText}"
                   Text="Der Team-Fokus trainiert passende Attribute für den ganzen Kader - langsam, über die Saison verteilt." />

            <CollectionView Grid.Row="2" ItemsSource="{Binding Focuses}" WidthRequest="800" HorizontalOptions="Start">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeamFocusRow">
                        <Grid Padding="3">
                            <Border Padding="12,10" BackgroundColor="{StaticResource RfmSurface}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Label}" FontSize="22"
                                           TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="{Binding ButtonText}"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetFocusCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{Binding ButtonColor}" TextColor="White"
                                            Padding="10,2" FontSize="18" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="1" Spacing="8" WidthRequest="800" HorizontalOptions="Start">
                <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource RfmAccentTeal}" />
                <Button Text="Übernehmen" Command="{Binding ConfirmCommand}"
                        BackgroundColor="{StaticResource RfmFormationGreen}" FontSize="22" TextColor="White" />
            </VerticalStackLayout>
        </Grid>

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding StatusText}" FontSize="14" TextColor="{StaticResource RfmText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</local:BaseContentPage>
