<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RetroFootballManager.Views.TrainingPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:TrainingViewModel"
    Title="Training"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="14" RowSpacing="10">

            <HorizontalStackLayout  Grid.Row="0" Spacing="20">
                <Picker Title="Spieler"
                        ItemsSource="{Binding SquadPlayers}" ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                        TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />
                <Label Grid.Column="0" Text="{Binding SelectedPlayerPosition}" FontSize="22" FontAttributes="Bold"
                        TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
                <Label Grid.Column="0" Text="{Binding PlayerInfo}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                <Border Grid.Column="1" 
                        Margin="8"
                        BackgroundColor="{StaticResource RfmSurface}"
                        WidthRequest="56"
                        HeightRequest="56" 
                        Padding="0"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowProfileCommand}" />
                    </Border.GestureRecognizers>
                    <Label  Text="ℹ" FontSize="40" TextColor="{StaticResource RfmText}" HorizontalOptions="Start" VerticalOptions="Start" />
                </Border>
            </Grid>
            <Label Grid.Row="2" Text="{Binding CoachInfo}" FontSize="12" TextColor="{StaticResource RfmTextMuted}" />

            <CollectionView Grid.Row="3" ItemsSource="{Binding Attributes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttributeRow">
                        <Grid Padding="3">
                            <Border Padding="12,8" BackgroundColor="{StaticResource RfmSurface}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,44,24,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Label}" FontSize="14"
                                           TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Value}" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding CoachHint}" FontSize="14"
                                           TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                    <Button Grid.Column="3" Text="{Binding FocusButtonText}"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetFocusCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{Binding FocusButtonColor}" TextColor="White"
                                            Padding="10,2" FontSize="12" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="4" Spacing="8">
                <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource RfmAccentTeal}" />
                <Button Text="Bestätigen" Command="{Binding ConfirmCommand}"
                        BackgroundColor="{StaticResource RfmAccent}" TextColor="White" />
            </VerticalStackLayout>
        </Grid>

        <!-- Player profile dialog -->
        <controls:PlayerProfileDialog
            IsOpen="{Binding IsPlayerProfileOpen}"
            Title="{Binding SelectedProfile.Name}"
            Profile="{Binding SelectedProfile}"
            CloseCommand="{Binding CloseProfileCommand}">
            <controls:PlayerProfileDialog.ExtraContent>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                      IsVisible="{Binding CanRenewContract}">
                    <Label Grid.Column="0" Text="{Binding RenewStatusText}" FontSize="11"
                           TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Verlängern (+2 J.)" Command="{Binding RenewContractCommand}"
                            BackgroundColor="{StaticResource RfmSurface}" TextColor="{StaticResource RfmText}"
                            FontSize="12" />
                </Grid>
            </controls:PlayerProfileDialog.ExtraContent>
        </controls:PlayerProfileDialog>

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding StatusText}" FontSize="14" TextColor="{StaticResource RfmText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
