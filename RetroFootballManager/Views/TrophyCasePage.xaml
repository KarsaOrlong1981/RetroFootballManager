<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.TrophyCasePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    x:DataType="vm:TrophyCaseViewModel"
    Title="Trophäen"
    BackgroundColor="{StaticResource RfmBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Trophies}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrophyDisplayRow">
                        <Border StrokeThickness="0" Padding="12" BackgroundColor="{StaticResource RfmSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="180,500" ColumnSpacing="14">
                                <Image Grid.Column="0" Source="{Binding ImagePath}" Aspect="AspectFit"
                                       HeightRequest="176" WidthRequest="176"
                                       Opacity="{Binding HasWonAtLeastOnce, Converter={StaticResource LockedOpacity}}" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding Label}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource RfmText}" />
                                    <Label FontSize="18" TextColor="{StaticResource RfmAccentTeal}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasWonAtLeastOnce}" Value="False">
                                                <Setter Property="Text" Value="Noch nicht gewonnen" />
                                                <Setter Property="TextColor" Value="{StaticResource RfmTextMuted}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.Text>
                                            <Binding Path="Count" StringFormat="{}{0}x gewonnen" />
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</local:BaseContentPage>
