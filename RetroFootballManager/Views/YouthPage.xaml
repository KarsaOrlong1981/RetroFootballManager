<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.YouthPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:models="clr-namespace:RetroFootballManager.Models;assembly=RetroFootballManager.Core"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:YouthViewModel"
    Title="Jugend"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Image Source="youth_ac.png" Aspect="Fill"/>
        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*" Padding="14" Opacity="0.85" RowSpacing="10">
            <Label Grid.Row="0" Padding="8,2"  FontSize="24" BackgroundColor="Black" HorizontalOptions="Start" VerticalTextAlignment="Center" TextColor="{StaticResource RfmText}"
                 Text="Jugend Trainer:" />
            <!-- Co-Trainer profiles -->
            <CollectionView 
                Grid.Row="1"
                ItemsSource="{Binding CoTrainers}"
                HorizontalOptions="Start" 
                WidthRequest="800"
                MaximumHeightRequest="880">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="0" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <ContentView>
                        <Border HorizontalOptions="Center" VerticalOptions="Center"  StrokeThickness="0" Padding="12,8"  BackgroundColor="{StaticResource RfmSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid>
                                <Label Grid.Column="0" Text="Aktuell sind keine Jugend Trainer Eingestellt." FontSize="22"
                            TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </ContentView>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Employee">
                        <Border  StrokeThickness="0" Padding="12,8"  BackgroundColor="{StaticResource RfmSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Image Source="{Binding ImagePath}" WidthRequest="150" HeightRequest="150"/>
                                <VerticalStackLayout Spacing="4" Grid.Column="1">
                                    <Label FontSize="18" TextColor="{StaticResource RfmText}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Name}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="16" TextColor="{StaticResource RfmTextMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding EmployeeType}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="18">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Fähigkeit Jugendentwicklung: " TextColor="{StaticResource RfmTextMuted}" />
                                                <Span Text="{Binding YouthDevelopment}" TextColor="{StaticResource RfmAccentTeal}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="18">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Fähigkeit Offensiv Training: " TextColor="{StaticResource RfmTextMuted}" />
                                                <Span Text="{Binding OffensiveTraining}" TextColor="{StaticResource RfmAccentTeal}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="18">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Fähigkeit Defensiv Training: " TextColor="{StaticResource RfmTextMuted}" />
                                                <Span Text="{Binding DefensiveTraining}" TextColor="{StaticResource RfmAccentTeal}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="18">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Fähigkeit Torwart Training: " TextColor="{StaticResource RfmTextMuted}" />
                                                <Span Text="{Binding GoalkeeperTraining}" TextColor="{StaticResource RfmAccentTeal}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <CollectionView Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Youth}"
                            SelectionMode="Single" SelectedItem="{Binding SelectedYouth, Mode=TwoWay}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Player">
                        <Grid Padding="3">
                            <Border Padding="12,8" BackgroundColor="{StaticResource RfmSurface}"   StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="50,100,*,Auto,Auto,26" ColumnSpacing="10">
                                    <Grid Grid.Column="1" WidthRequest="100" HeightRequest="100" >
                                        <Image Source="avatar.png" Aspect="AspectFit"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource NoLogo}}" />
                                        <Image Source="{Binding ImagePath}" Aspect="AspectFit"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource HasLogo}}" />
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding Name}" FontSize="18" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding ShortPositionName}" FontSize="18" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding Age, StringFormat='{0} Jahre'}" FontSize="16"
                                               TextColor="{StaticResource RfmTextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding Rating, StringFormat='R {0:0}'}" FontSize="18"
                                           TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding Talent, StringFormat='T {0}'}" FontSize="18"
                                           FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="32" HeightRequest="32" Padding="0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="11" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="info.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                <Label Text="{Binding YouthInfo}" FontSize="18" TextColor="{StaticResource RfmText}" />
                <Label Text="{Binding CurrentMentorInfo}" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource RfmAccentTeal}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" WidthRequest="800" HorizontalOptions="Start">
                    <Picker Grid.Column="0" Title="Mentor auswählen"
                            BackgroundColor="Blue" 
                            FontSize="18"
                            WidthRequest="380"
                            HorizontalOptions="Start"
                            ItemsSource="{Binding Mentors}" ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedMentor, Mode=TwoWay}"
                            TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmText}" />
                    <Button Grid.Column="1" Text="Zuweisen" FontSize="18" VerticalOptions="End" Command="{Binding AssignMentorCommand}"
                            BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmText}" />
                    <Button Grid.Column="2" Text="Entfernen" FontSize="18" VerticalOptions="End" Command="{Binding RemoveMentorCommand}"
                            IsVisible="{Binding HasMentor}"
                            BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
                </Grid>
                <Label Text="{Binding StatusText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Hochziehen" FontSize="18" Command="{Binding PromoteCommand}"
                            BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmText}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Player profile dialog -->
        <controls:PlayerProfileDialog
            Grid.ColumnSpan="2"
            Grid.RowSpan="3"
            IsOpen="{Binding IsPlayerProfileOpen}"
            Title="{Binding SelectedProfile.Name}"
            Profile="{Binding SelectedProfile}"
            CloseCommand="{Binding CloseProfileCommand}" />

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}" Grid.ColumnSpan="2" Grid.RowSpan="3"   BackgroundColor="#C0000000">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding StatusText}" FontSize="14" TextColor="{StaticResource RfmText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</local:BaseContentPage>
