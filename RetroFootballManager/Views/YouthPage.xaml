<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.YouthPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:models="clr-namespace:RetroFootballManager.Models;assembly=RetroFootballManager.Core"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:YouthViewModel"
    Title="Jugend"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Image Source="youth_ac.png" Aspect="Fill"/>
        <Grid RowDefinitions="*,Auto" Padding="14" Opacity="0.85" RowSpacing="10">

            <CollectionView Grid.Row="0" ItemsSource="{Binding Youth}"
                            SelectionMode="Single" SelectedItem="{Binding SelectedYouth, Mode=TwoWay}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Player">
                        <Grid Padding="3">
                            <Border Padding="12,8" BackgroundColor="{StaticResource RfmSurface}" WidthRequest="850" HorizontalOptions="Start" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="50,100,*,Auto,Auto,26" ColumnSpacing="10">
                                    <Grid Grid.Column="1" WidthRequest="100" HeightRequest="100" >
                                        <Image Source="avatar.png" Aspect="AspectFit"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource NoLogo}}" />
                                        <Image Source="{Binding ImagePath}" Aspect="AspectFit"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource HasLogo}}" />
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding Name}" FontSize="18" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding ShortPositionName}" FontSize="18" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding Age, StringFormat='{0} Jahre'}" FontSize="16"
                                               TextColor="{StaticResource RfmTextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding Rating, StringFormat='R {0:0}'}" FontSize="18"
                                           TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding Talent, StringFormat='T {0}'}" FontSize="18"
                                           FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="32" HeightRequest="32" Padding="0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="11" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="info.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <Label Text="{Binding YouthInfo}" FontSize="18" TextColor="{StaticResource RfmText}" />
                <Label Text="{Binding CurrentMentorInfo}" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource RfmAccentTeal}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" WidthRequest="800" HorizontalOptions="Start">
                    <Picker Grid.Column="0" Title="Mentor auswählen"
                            BackgroundColor="Blue" 
                            FontSize="18"
                            WidthRequest="380"
                            HorizontalOptions="Start"
                            ItemsSource="{Binding Mentors}" ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedMentor, Mode=TwoWay}"
                            TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmText}" />
                    <Button Grid.Column="1" Text="Zuweisen" FontSize="18" VerticalOptions="End" Command="{Binding AssignMentorCommand}"
                            BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmText}" />
                    <Button Grid.Column="2" Text="Entfernen" FontSize="18" VerticalOptions="End" Command="{Binding RemoveMentorCommand}"
                            IsVisible="{Binding HasMentor}"
                            BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
                </Grid>
                <Label Text="{Binding StatusText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Hochziehen" FontSize="18" Command="{Binding PromoteCommand}"
                            BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmText}" />
                    <Button Grid.Column="1" Text="Bestätigen" FontSize="18" Command="{Binding ConfirmCommand}"
                            BackgroundColor="{StaticResource RfmAccent}" TextColor="White" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Player profile dialog -->
        <controls:PlayerProfileDialog
            IsOpen="{Binding IsPlayerProfileOpen}"
            Title="{Binding SelectedProfile.Name}"
            Profile="{Binding SelectedProfile}"
            CloseCommand="{Binding CloseProfileCommand}" />

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding StatusText}" FontSize="14" TextColor="{StaticResource RfmText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</local:BaseContentPage>
