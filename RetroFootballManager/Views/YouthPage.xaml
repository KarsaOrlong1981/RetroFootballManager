<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RetroFootballManager.Views.YouthPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:models="clr-namespace:RetroFootballManager.Models;assembly=RetroFootballManager.Core"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:YouthViewModel"
    Title="Jugend"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Grid RowDefinitions="*,Auto" Padding="14" RowSpacing="10">

            <CollectionView Grid.Row="0" ItemsSource="{Binding Youth}"
                            SelectionMode="Single" SelectedItem="{Binding SelectedYouth, Mode=TwoWay}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Player">
                        <Grid Padding="3">
                            <Border Padding="12,8" BackgroundColor="{StaticResource RfmSurface}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto,Auto,26" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Name}" FontSize="14" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding ShortPositionName}" FontSize="12" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding Age, StringFormat='{0} Jahre'}" FontSize="11"
                                               TextColor="{StaticResource RfmTextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Rating, StringFormat='R {0:0}'}" FontSize="13"
                                           TextColor="{StaticResource RfmText}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Talent, StringFormat='T {0}'}" FontSize="13"
                                           FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                    <Border Grid.Column="3" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="22" HeightRequest="22" Padding="0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="11" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="ℹ" FontSize="11" TextColor="{StaticResource RfmText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <Label Text="{Binding YouthInfo}" FontSize="13" TextColor="{StaticResource RfmText}" />
                <Label Text="{Binding CurrentMentorInfo}" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource RfmAccentTeal}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Picker Grid.Column="0" Title="Mentor auswählen"
                            BackgroundColor="Blue" 
                            WidthRequest="200"
                            HorizontalOptions="Start"
                            ItemsSource="{Binding Mentors}" ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedMentor, Mode=TwoWay}"
                            TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />
                    <Button Grid.Column="1" Text="Zuweisen" Command="{Binding AssignMentorCommand}"
                            BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmBackground}" />
                    <Button Grid.Column="2" Text="Entfernen" Command="{Binding RemoveMentorCommand}"
                            IsVisible="{Binding HasMentor}"
                            BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
                </Grid>
                <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource RfmAccentTeal}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Hochziehen" Command="{Binding PromoteCommand}"
                            BackgroundColor="{StaticResource RfmAccentTeal}" TextColor="{StaticResource RfmBackground}" />
                    <Button Grid.Column="1" Text="Bestätigen" Command="{Binding ConfirmCommand}"
                            BackgroundColor="{StaticResource RfmAccent}" TextColor="White" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Player profile dialog -->
        <controls:PlayerProfileDialog
            IsOpen="{Binding IsPlayerProfileOpen}"
            Title="{Binding SelectedProfile.Name}"
            Profile="{Binding SelectedProfile}"
            CloseCommand="{Binding CloseProfileCommand}" />

        <!-- Busy overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding StatusText}" FontSize="14" TextColor="{StaticResource RfmText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
