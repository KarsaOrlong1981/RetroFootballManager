<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.InboxPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    x:DataType="vm:InboxViewModel"
    Title="Postfach"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid RowDefinitions="*,Auto" Padding="14" RowSpacing="10">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Start" MaximumWidthRequest="880" BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:InboxMessageRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Padding="12,10" BackgroundColor="{StaticResource RfmSurface}"
                                    StrokeThickness="0" Opacity="{Binding IsRead, Converter={StaticResource ReadOpacity}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.MarkReadCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Title}" FontSize="14"
                                               FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                                        <Label Grid.Column="1" Text="{Binding DateText}" FontSize="11"
                                               TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="{Binding Body}" FontSize="12" TextColor="{StaticResource RfmTextMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" Padding="0"
                                    BackgroundColor="{StaticResource RfmText}" StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Image Source="trash.png" WidthRequest="42" HeightRequest="42" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource RfmAccentTeal}" />
            <Button Text="Zurück" Command="{Binding BackCommand}"
                    BackgroundColor="{StaticResource RfmSurfaceAlt}" TextColor="{StaticResource RfmText}" />
        </VerticalStackLayout>
    </Grid>
</local:BaseContentPage>
