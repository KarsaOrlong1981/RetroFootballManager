<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.FinancesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:models="clr-namespace:RetroFootballManager.Models;assembly=RetroFootballManager.Core"
    x:DataType="vm:FinancesViewModel"
    Title="Finanzen"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid ColumnDefinitions="*,*">
        <Image Grid.ColumnSpan="2" Source="finaces.png" Opacity="0.6" Aspect="AspectFill"/>

    <ScrollView Grid.Column="0">
        <VerticalStackLayout Opacity="0.95" Padding="20" Spacing="14">

            <Border StrokeThickness="0" Padding="16" HorizontalOptions="Start"  WidthRequest="800" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Kontostand" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                    <Label Text="{Binding BalanceText}" FontSize="30" FontAttributes="Bold"
                           TextColor="{StaticResource RfmAccentTeal}" />
                    <Label Text="{Binding FinancialHealthText, StringFormat='Finanzielle Gesundheit: {0}'}"
                           FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                    <Label Text="Kontostand zum Saisonende (Schätzung)" FontSize="18"
                           TextColor="{StaticResource RfmTextMuted}" Margin="0,6,0,0" />
                    <Label Text="{Binding SeasonEndForecastText}" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource RfmAccentTeal}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Gehälter, Sponsoreneinnahmen und Stadion-Unterhalt werden jeden 15. des Monats abgerechnet."
                   FontSize="18" TextColor="{StaticResource RfmText}" />

            <Label Text="Kredit" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Border StrokeThickness="0" Padding="14" HorizontalOptions="Start" WidthRequest="800" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8"
                          IsVisible="{Binding HasActiveLoan}">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Restschuld" TextColor="{StaticResource RfmText}" />
                            <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding LoanRemainingText}" TextColor="#EF4444" />
                            <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Monatliche Rate" TextColor="{StaticResource RfmText}" />
                            <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding LoanMonthlyPaymentText}" TextColor="#EF4444" />
                            <Label Grid.Row="2" Grid.Column="0" FontSize="18" Text="Zinssatz" TextColor="{StaticResource RfmText}" />
                            <Label Grid.Row="2" Grid.Column="1"  FontSize="18" Text="{Binding LoanInterestRateText}" TextColor="{StaticResource RfmTextMuted}" />
                            <Label Grid.Row="3" Grid.Column="0" FontSize="18" Text="Voraussichtlich abbezahlt" TextColor="{StaticResource RfmText}" />
                            <Label Grid.Row="3" Grid.Column="1" FontSize="18" Text="{Binding LoanPayoffEstimateText}" TextColor="{StaticResource RfmTextMuted}" />
                    </Grid>
                    <Label Text="Kein Kredit aufgenommen." FontSize="18" TextColor="{StaticResource RfmTextMuted}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasActiveLoan}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding HasActiveLoan}" Value="False">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Text="Kredit aufnehmen" FontSize="18" Command="{Binding TakeLoanCommand}"
                            BackgroundColor="{StaticResource RfmAccent}" TextColor="White">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasActiveLoan}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding HasActiveLoan}" Value="False">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <Label Text="Einnahmen" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Border StrokeThickness="0" Padding="14" HorizontalOptions="Start" WidthRequest="800" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Ticketeinnahmen" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding TicketIncomeText}" TextColor="{StaticResource RfmAccentTeal}" />
                        <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Sponsoren" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding SponsorIncomeText}" TextColor="{StaticResource RfmAccentTeal}" />
                        <Label Grid.Row="2" Grid.Column="0" FontSize="18" Text="Merchandise" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="2" Grid.Column="1" FontSize="18" Text="{Binding MerchandiseIncomeText}" TextColor="{StaticResource RfmAccentTeal}" />
                </Grid>
            </Border>

            <Label Text="Vereinsmitglieder" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Border StrokeThickness="0" Padding="14" HorizontalOptions="Start" WidthRequest="800" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Mitglieder" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding MembershipCountText}" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Beitrag pro Mitglied" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding MembershipFeeText}" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="2" Grid.Column="0" FontSize="18" Text="Einnahmen pro Monat" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="2" Grid.Column="1" FontSize="18" Text="{Binding MembershipIncomeMonthlyText}" TextColor="{StaticResource RfmAccentTeal}" />
                        <Label Grid.Row="3" Grid.Column="0" FontSize="18" Text="Einnahmen pro Jahr" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="3" Grid.Column="1" FontSize="18" Text="{Binding MembershipIncomeYearlyText}" TextColor="{StaticResource RfmAccentTeal}" />
                </Grid>
            </Border>

            <Label Text="Sponsoren im Detail" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Label Text="Die Grundzahlung läuft monatlich zum 15.; alle Bonuszahlungen (pro Sieg, Aufstieg, Platzierung) werden erst am Saisonende ausgezahlt."
                   FontSize="18" TextColor="{StaticResource RfmText}" />
            <CollectionView ItemsSource="{Binding SponsorDeals}" HorizontalOptions="Start" WidthRequest="800" MinimumHeightRequest="60">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SponsorOverviewItem">
                        <Border StrokeThickness="0" Padding="14" WidthRequest="800" HorizontalOptions="Start"
                                BackgroundColor="{StaticResource RfmSurface}" Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding SlotLabel}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Text="{Binding SponsorName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                                <Label Text="{Binding SeasonPaymentText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
                                <Label Text="{Binding PaymentPerMonthText}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Text="{Binding ExpiresText}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                <Label Text="Mögliche Bonuszahlungen (am Saisonende):" FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource RfmText}" Margin="0,4,0,0" />
                                <CollectionView ItemsSource="{Binding Offers}" ItemsLayout="VerticalList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BonusOffers">
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding Offer}" FontSize="18" TextColor="{StaticResource RfmText}" />
                                                <Label Text="{Binding Payment, StringFormat='{0:N0} €'}" FontSize="14"
                                                       TextColor="{StaticResource RfmAccentTeal}" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Aktuelle laufende Kosten/Einnahmen" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
            <Label Text="Wirkt sich ab dem nächsten Spieltag auf die Bilanz aus." FontSize="16" TextColor="{StaticResource RfmTextMuted}" />
            <Border StrokeThickness="0" Padding="14" WidthRequest="800" HorizontalOptions="Start" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Mitarbeitergehälter" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding CurrentStaffWagesText}" TextColor="#EF4444" />
                        <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Spielergehälter" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding CurrentPlayerWagesText}" TextColor="#EF4444" />
                        <Label Grid.Row="2" Grid.Column="0" FontSize="18" Text="Sponsoreneinnahmen" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="2" Grid.Column="1" FontSize="18" Text="{Binding CurrentSponsorIncomeText}" TextColor="{StaticResource RfmAccentTeal}" />
                        <Label Grid.Row="3" Grid.Column="0" FontSize="18" Text="Stadion-Unterhalt" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="3" Grid.Column="1" FontSize="18" Text="{Binding CurrentStadiumMaintenanceText}" TextColor="#EF4444" />
                </Grid>
            </Border>

            <Label Text="Diese Saison bereits gebucht" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" Margin="0,6,0,0" />
                <Border StrokeThickness="0" Padding="14" WidthRequest="800" HorizontalOptions="Start" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Mitarbeitergehälter" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding StaffWagesText}" TextColor="#EF4444" />
                        <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Stadionkosten" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding StadiumCostsText}" TextColor="#EF4444" />
                        <Label Grid.Row="2" Grid.Column="0" FontSize="18" Text="Preisgelder" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="2" Grid.Column="1" FontSize="18" Text="{Binding PrizeMoneyText}" TextColor="{StaticResource RfmAccentTeal}" />
                </Grid>
            </Border>

            <Label Text="Transfers" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                <Border StrokeThickness="0" Padding="14" WidthRequest="800" HorizontalOptions="Start" BackgroundColor="{StaticResource RfmSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Einnahmen" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding TransferIncomeText}" TextColor="{StaticResource RfmAccentTeal}" />
                        <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Ausgaben" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding TransferExpenseText}" TextColor="#EF4444" />
                </Grid>
            </Border>

            <Label Text="Sonstiges" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />
                <Border StrokeThickness="0" Padding="14" WidthRequest="800" HorizontalOptions="Start" BackgroundColor="{StaticResource RfmSurface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" FontSize="18" Text="Einnahmen (z.B. Freundschaftsspiele)" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding OtherIncomeText}" TextColor="{StaticResource RfmAccentTeal}" />
                        <Label Grid.Row="1" Grid.Column="0" FontSize="18" Text="Ausgaben (z.B. Trainingslager)" TextColor="{StaticResource RfmText}" />
                        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Text="{Binding OtherExpensesText}" TextColor="#EF4444" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
    </ScrollView>

    <Border Grid.Column="1" StrokeThickness="0" Padding="12,8" Margin="10"
            MaximumHeightRequest="200"
         BackgroundColor="{StaticResource RfmSurface}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasDirectorOfFootball}">
                <Image Source="{Binding DirectorOfFootballImagePath}" WidthRequest="150" HeightRequest="150" HorizontalOptions="Center"/>
                    <VerticalStackLayout Spacing="4" Grid.Column="1">
                        <Label Text="{Binding DirectorOfFootballName}" FontSize="18" FontAttributes="Bold"  
                             TextColor="{StaticResource RfmText}" HorizontalOptions="Start" />
                        <Label Text="Sportdirektor" FontSize="16" TextColor="{StaticResource RfmTextMuted}" HorizontalOptions="Start" />
                        <Label FontSize="18">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Verkaufsverhandlung: " TextColor="{StaticResource RfmTextMuted}" />
                                    <Span Text="{Binding DirectorOfFootballSellingNegotiation}" TextColor="{StaticResource RfmAccentTeal}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="18">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Gegenangebote: " TextColor="{StaticResource RfmTextMuted}" />
                                    <Span Text="{Binding DirectorOfFootballCounterOfferNegotiation}" TextColor="{StaticResource RfmAccentTeal}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="18">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Verhandlungshärte: " TextColor="{StaticResource RfmTextMuted}" />
                                    <Span Text="{Binding DirectorOfFootballAcceptanceFirmness}" TextColor="{StaticResource RfmAccentTeal}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="18">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Finanzmanagement: " TextColor="{StaticResource RfmTextMuted}" />
                                    <Span Text="{Binding DirectorOfFootballFinancialManagement}" TextColor="{StaticResource RfmAccentTeal}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasDirectorOfFootball, Converter={StaticResource InvertedBool}}">
                <Label Text="Kein Sportdirektor eingestellt." FontSize="24" TextColor="{StaticResource RfmTextMuted}" HorizontalOptions="Center" />
                <Button Text="Mitarbeiter" FontSize="16" Command="{Binding OpenStaffCommand}"
                        BackgroundColor="{StaticResource RfmAccent}" TextColor="White" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Border>
    </Grid>
</local:BaseContentPage>
