<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RetroFootballManager.Views.TeamSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    x:DataType="vm:TeamSelectionViewModel"
    Title="Team auswählen"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Team auswählen" FontSize="24" FontAttributes="Bold"
                   TextColor="{StaticResource RfmText}" />
            <Label Text="{Binding CareerInfo}" FontSize="13"
                   TextColor="{StaticResource RfmTextMuted}" />
        </VerticalStackLayout>

        <!-- Liga-Auswahl -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Leagues}"
                        SelectedItem="{Binding SelectedLeague, Mode=TwoWay}"
                        SelectionMode="Single"
                        HeightRequest="72">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeagueOption">
                    <Border StrokeThickness="0" Padding="14,8" MinimumWidthRequest="130"
                            BackgroundColor="{StaticResource RfmSurface}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Opacity="{Binding IsUnlocked, Converter={StaticResource LockedOpacity}}">
                            <Label Text="{Binding Name}" FontAttributes="Bold"
                                   TextColor="{StaticResource RfmText}" />
                            <Label Text="{Binding StatusLabel}" FontSize="11"
                                   TextColor="{StaticResource RfmTextMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Team-Liste der gewählten Liga -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Teams}"
                        SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TeamOption">
                    <Grid Padding="4">
                        <Border StrokeThickness="0" Padding="12,10"
                                BackgroundColor="{StaticResource RfmSurface}"
                                Opacity="{Binding IsSelectable, Converter={StaticResource LockedOpacity}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                <!-- Wappen: Bild wenn vorhanden, sonst Kürzel-Platzhalter -->
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource RfmAccentTeal}" StrokeThickness="1.5" Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding Team.LogoPath, Converter={StaticResource LogoSource}}"
                                               IsVisible="{Binding Team.LogoPath, Converter={StaticResource HasLogo}}"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding ShortName}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource RfmAccentTeal}"
                                               IsVisible="{Binding Team.LogoPath, Converter={StaticResource NoLogo}}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center"
                                       TextColor="{StaticResource RfmText}" />
                                <Label Grid.Column="2" Text="{Binding AverageRating}" VerticalOptions="Center"
                                       FontAttributes="Bold" TextColor="{StaticResource RfmAccentTeal}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <Label Text="{Binding SelectionHint}" FontSize="12"
                   TextColor="{StaticResource RfmTextMuted}" />

            <Label Text="Schwierigkeitsgrad" FontSize="12" TextColor="{StaticResource RfmTextMuted}" />
            <Picker ItemsSource="{Binding DifficultyOptions}" ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}"
                    TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmTextMuted}" />
            <Label Text="{Binding SelectedDifficulty.Description}" FontSize="11"
                   TextColor="{StaticResource RfmTextMuted}" />

            <Button Text="Neues Spiel starten"
                    Command="{Binding StartCommand}"
                    BackgroundColor="{StaticResource RfmAccent}" TextColor="White" />
        </VerticalStackLayout>

        <!-- Busy overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsBusy}" BackgroundColor="#C0000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RfmAccentTeal}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding BusyText}" FontSize="14" TextColor="{StaticResource RfmText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
