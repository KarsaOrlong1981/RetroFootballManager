<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.StatisticsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:StatisticsViewModel"
    Title="Statistiken"
    BackgroundColor="{StaticResource RfmBackground}">

    <Grid>
        <Image Source="headerscene.png" Aspect="Fill"/>
        <Grid RowDefinitions="Auto,*,Auto" Opacity="0.85" Padding="14" RowSpacing="10">

            <Picker Grid.Row="0" Title="Kategorie"
                    BackgroundColor="Blue"
                    FontSize="28"
                    WidthRequest="380"
                    HorizontalOptions="Start"
                    ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    TextColor="{StaticResource RfmText}" TitleColor="{StaticResource RfmText}" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatRankRow">
                        <Grid Padding="3">
                            <Border Padding="12,8" BackgroundColor="{StaticResource RfmSurface}"  WidthRequest="850" HorizontalOptions="Start" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="58,36,*,50,80,26" ColumnSpacing="10">
                                    <Label Grid.Column="1" Text="{Binding Rank}" FontSize="22" FontAttributes="Bold"
                                           TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding PlayerName}" FontSize="22" TextColor="{StaticResource RfmText}" />
                                        <Label Text="{Binding TeamName}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding PositionShort}" FontSize="22"
                                           TextColor="{StaticResource RfmTextMuted}" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding Value}" FontSize="18" FontAttributes="Bold"
                                           TextColor="{StaticResource RfmAccentTeal}" VerticalOptions="Center" />
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource RfmSurfaceAlt}" WidthRequest="26" HeightRequest="26" Padding="0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="11" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowProfileCommand}"
                                                CommandParameter="{Binding PlayerId}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="info.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Label Text="{Binding StatusText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Player profile dialog: full profile if scouted, otherwise just name + "?". -->
        <controls:PlayerProfileDialog
            IsOpen="{Binding IsPlayerProfileOpen}"
            Title="{Binding SelectedPlayerName}"
            Profile="{Binding SelectedProfile}"
            CloseCommand="{Binding CloseProfileCommand}"
            IsLocked="{Binding IsSelectedPlayerNotScouted}"
            LockedStatusText="{Binding ScoutingStatusText}"
            IsLockedBusy="{Binding IsBeingScouted}"
            UnlockCommand="{Binding ScoutPlayerCommand}" />
    </Grid>
</local:BaseContentPage>
