<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    x:Class="RetroFootballManager.Views.StaffPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RetroFootballManager.Views"
    xmlns:vm="clr-namespace:RetroFootballManager.ViewModels"
    xmlns:models="clr-namespace:RetroFootballManager.Models;assembly=RetroFootballManager.Core"
    xmlns:controls="clr-namespace:RetroFootballManager.Views.Controls"
    x:DataType="vm:StaffViewModel"
    Title="Mitarbeiter"
    BackgroundColor="{StaticResource RfmBackground}">
    <Grid>
        <Image Source="meetingroom.png" Aspect="AspectFill"/>
        <Grid RowDefinitions="Auto,*,Auto,Auto,*,Auto" Opacity="0.85" Padding="20" RowSpacing="8">
            <Label Grid.Row="0" Text="Aktuelles Personal" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />

        <CollectionView Grid.Row="1"  ItemsSource="{Binding CurrentStaff}" WidthRequest="800" HorizontalOptions="Start">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Employee">
                    <Grid Padding="3">
                        <Border Padding="10,8" BackgroundColor="{StaticResource RfmSurface}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Grid Grid.Column="0" WidthRequest="56" HeightRequest="56" Margin="0,0,10,0">
                                    <Image Source="avatar.png" Aspect="AspectFit"
                                           IsVisible="{Binding ImagePath, Converter={StaticResource NoLogo}}" />
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFit"
                                           IsVisible="{Binding ImagePath, Converter={StaticResource HasLogo}}" />
                                </Grid>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Name}" FontSize="22" TextColor="{StaticResource RfmText}" FontAttributes="Bold" />
                                    <Label Text="{Binding EmployeeType, StringFormat='{0}'}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
                                    <Label Text="{Binding Salary, StringFormat='Gehalt: {0:N0} € / Jahr'}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Entlassen"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.FireCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EF4444" TextColor="White" FontSize="18" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalOptions="Start">
            <Button Grid.Column="0" WidthRequest="390" Text="Kandidaten suchen" Command="{Binding GenerateCandidatesCommand}"
                    BackgroundColor="{StaticResource RfmAccent}" FontSize="24" TextColor="{StaticResource RfmText}" />
            <Button Grid.Column="1" WidthRequest="390" Text="Mein Profil" Command="{Binding ShowManagerProfileCommand}"
                    BackgroundColor="{StaticResource RfmSurface}" FontSize="24" TextColor="{StaticResource RfmText}" />
        </Grid>

        <Label Grid.Row="3" Text="Kandidaten" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource RfmText}" />

        <CollectionView Grid.Row="4"  ItemsSource="{Binding Candidates}" WidthRequest="800" HorizontalOptions="Start">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Employee">
                    <Grid Padding="3">
                        <Border Padding="10,8" BackgroundColor="{StaticResource RfmSurface}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Grid Grid.Column="0" WidthRequest="56" HeightRequest="56" Margin="0,0,10,0">
                                    <Image Source="avatar.png" Aspect="AspectFit"
                                           IsVisible="{Binding ImagePath, Converter={StaticResource NoLogo}}" />
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFit"
                                           IsVisible="{Binding ImagePath, Converter={StaticResource HasLogo}}" />
                                </Grid>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Name}" FontSize="22" TextColor="{StaticResource RfmText}" FontAttributes="Bold" />
                                    <Label Text="{Binding EmployeeType, StringFormat='{0}'}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
                                    <Label Text="{Binding Rating, StringFormat='Rating: {0:0.0}'}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                    <Label Text="{Binding Salary, StringFormat='Gehalt: {0:N0} € / Jahr'}" FontSize="18" TextColor="{StaticResource RfmTextMuted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Einstellen"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.HireCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource RfmAccent}" TextColor="White" FontSize="18" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="5" Text="{Binding StatusText}" FontSize="18" TextColor="{StaticResource RfmAccentTeal}" />
    </Grid>

        <controls:ManagerProfileDialog
            IsOpen="{Binding IsManagerProfileDialogOpen}"
            Profile="{Binding OwnManagerProfile}"
            IsEditable="True"
            RemainingPoints="{Binding ManagerRemainingPoints}"
            IncreaseSkillCommand="{Binding IncreaseManagerSkillCommand}"
            CloseCommand="{Binding CloseManagerProfileCommand}" />
    </Grid>
</local:BaseContentPage>
