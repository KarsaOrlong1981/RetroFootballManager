<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RetroFootballManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RetroFootballManager.Views"
    FlyoutBehavior="Disabled"
    Title="RetroFootballManager">

    <ShellContent
        Title="Start"
        ContentTemplate="{DataTemplate views:StartPage}"
        Route="start" />

    <ShellContent
        Title="Hauptmenü"
        ContentTemplate="{DataTemplate views:MainMenuPage}"
        Route="mainmenu" />

</Shell>
